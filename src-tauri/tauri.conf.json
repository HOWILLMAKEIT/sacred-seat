{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "神圣座位",
  "version": "0.1.20",
  "identifier": "com.howill.dingshi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "神圣座位",
        "width": 1180,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "CTDP 与 RSIP 的本地自控工具",
    "longDescription": "使用神圣座位、永久判例和国策树，逐步改变行为稳态。",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxRDY5NkY0RTRFNkFGOApSV1Q0YWs1T2Iya2REUGF5K0E3VVhOQXFIajZvS0FVMWp3M1hLc0NhVWdTc0VWRjVFMVlZR2QycAo=",
      "endpoints": [
        "https://github.com/HOWILLMAKEIT/sacred-seat/releases/latest/download/latest.json"
      ]
    }
  }
}
